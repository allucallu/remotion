{
  "name": "Remotion",
  "version": "1.0.0",
  "description": "Adobe Stock 4K Technology & Data Motion Graphics Pack",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.465",
    "@remotion/google-fonts": "4.0.465",
    "@remotion/noise": "4.0.465",
    "@remotion/tailwind-v4": "4.0.465",
    "@remotion/zod-types": "4.0.465",
    "lucide-react": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.465",
    "tailwindcss": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.465",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint script && tsc",
    "render:live-json": "remotion render LiveJSONResponseStream out/LiveJSONResponseStream_4K.mp4 --codec=h264",
    "render:data-stream": "remotion render DigitalDataStreamBackground out/DigitalDataStreamBackground_4K.mp4 --codec=h264",
    "render:badge-cycle": "remotion render StatusIndicatorBadgeCycle out/StatusIndicatorBadgeCycle_4K.mp4 --codec=h264",
    "render:flow-pulse": "remotion render DataFlowConnectionPulse out/DataFlowConnectionPulse_4K.mp4 --codec=h264",
    "render:request-builder": "remotion render RequestBuilderMockup out/RequestBuilderMockup_4K.mp4 --codec=h264",
    "render:terminal-typing": "remotion render TerminalCurlTyping out/TerminalCurlTyping_4K.mp4 --codec=h264",
    "render:tree-expand": "remotion render JSONTreeExpandCollapse out/JSONTreeExpandCollapse_4K.mp4 --codec=h264",
    "render:loading-result": "remotion render LoadingResultTransition out/LoadingResultTransition_4K.mp4 --codec=h264",
    "render:header-inspector": "remotion render HeaderInspectorPanel out/HeaderInspectorPanel_4K.mp4 --codec=h264",
    "render:data-ticker": "remotion render RealtimeDataTicker out/RealtimeDataTicker_4K.mp4 --codec=h264",
    "render:diff-validation": "remotion render DataDiffValidationOverlay out/DataDiffValidationOverlay_4K.mp4 --codec=h264",
    "render:all": "npm run render:live-json && npm run render:data-stream && npm run render:badge-cycle && npm run render:flow-pulse && npm run render:request-builder && npm run render:terminal-typing && npm run render:tree-expand && npm run render:loading-result && npm run render:header-inspector && npm run render:data-ticker && npm run render:diff-validation"
  },
  "sideEffects": [
    "*.css"
  ]
}
